<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Existing Night BGM -->
  <SongDef>
    <defName>Cultist_ObservatoryAfterDusk</defName>
    <clipPath>Cultist/ObservatoryAfterDusk</clipPath>
    <allowedTimeOfDay>Night</allowedTimeOfDay>
    <playOnMap>true</playOnMap>
    <commonality>0.6</commonality>
    <volume>0.5</volume>
  </SongDef>

