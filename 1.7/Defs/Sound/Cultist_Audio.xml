  </SongDef>
  <SongDef>
    <defName>Cultist_BGM_ImpendingGlory</defName>
    <clipPath>Cultist/BGM_ImpendingGlory</clipPath>
    <tense>true</tense>
    <playOnMap>true</playOnMap>
    <commonality>0.8</commonality>
    <volume>0.6</volume>
  </SongDef>

  <!-- Existing Dream Sting -->
  <SoundDef>
    <defName>Cultist_DreamSting</defName>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <onCamera>true</onCamera>
        <grains><li Class="AudioGrain_Clip"><clipPath>Cultist/DreamSting</clipPath></li></grains>
        <volumeRange>32~32</volumeRange>
      </li>
    </subSounds>
  </SoundDef>

