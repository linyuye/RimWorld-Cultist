    <playOnMap>true</playOnMap>
    <commonality>0.7</commonality>
    <volume>0.55</volume>
  </SongDef>
  <SongDef>
    <defName>Cultist_BGM_SunInRags</defName>
    <clipPath>Cultist/BGM_SunInRags</clipPath>
    <allowedTimeOfDay>Day</allowedTimeOfDay>
    <playOnMap>true</playOnMap>
    <commonality>0.65</commonality>
    <volume>0.5</volume>
  </SongDef>
  <SongDef>
    <defName>Cultist_BGM_CircularTheme</defName>
    <clipPath>Cultist/BGM_CircularTheme</clipPath>
