          <ArmorRating_Heat>0.32</ArmorRating_Heat>
          <MoveSpeed>0.15</MoveSpeed>
          <PainShockThreshold>0.18</PainShockThreshold>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.72</IncomingDamageFactor>
          <MeleeDamageFactor>1.28</MeleeDamageFactor>
          <AimingDelayFactor>0.85</AimingDelayFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.52</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
          <ArmorRating_Heat>0.46</ArmorRating_Heat>
          <MoveSpeed>0.25</MoveSpeed>
          <PainShockThreshold>0.25</PainShockThreshold>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.60</IncomingDamageFactor>
