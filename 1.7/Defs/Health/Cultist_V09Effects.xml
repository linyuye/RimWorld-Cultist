    <defName>Cultist_Thought_LanternLight</defName>
    <workerClass>Cultist.ThoughtWorker_DoctrineLantern</workerClass>
    <stages>
      <li>
        <label>merciless illumination</label>
        <description>Clear light reveals what shadows conceal.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
      <li>
        <label>unlit gloom</label>
        <description>Working in dim shadow blinds the Watchman's student.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

