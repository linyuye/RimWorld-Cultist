          <MoveSpeed>0.35</MoveSpeed>
          <PainShockThreshold>0.35</PainShockThreshold>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>0.50</IncomingDamageFactor>
          <MeleeDamageFactor>1.60</MeleeDamageFactor>
          <AimingDelayFactor>0.72</AimingDelayFactor>
        </statFactors>
      </li>
    </stages>
