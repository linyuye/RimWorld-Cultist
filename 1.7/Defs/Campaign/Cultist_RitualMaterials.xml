<Defs>
  <ThingDef Name="Cultist_RiteMaterialBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <useHitPoints>true</useHitPoints>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>Items</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>
  <ThingDef Name="Cultist_LoreBase" ParentName="Cultist_RiteMaterialBase" Abstract="True">
    <graphicData>
      <texPath>Cultist/Items/Lore_Lantern1</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.4</Mass>
      <Flammability>1</Flammability>
    </statBases>
    <comps>
      <li Class="Cultist.InteractionProperties" />
    </comps>
  </ThingDef>
