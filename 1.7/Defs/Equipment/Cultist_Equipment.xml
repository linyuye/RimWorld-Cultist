<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Cultist_FieldCoat</defName>
    <label>observatory coat</label>
    <description>A durable coat made for night shifts in the colony observatory.</description>
    <graphicData>
      <texPath>Cultist/Equipment/FieldCoat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <comps><li Class="Cultist.AffinityGearInspectProperties"/></comps>
    <modExtensions>
      <li Class="Cultist.AffinityGear">
        <affinity>Lantern</affinity>
        <stat>ResearchSpeed</stat>
        <rankBonuses><li>0.10</li><li>0.15</li><li>0.20</li></rankBonuses>
        <stageBonuses><li>0.05</li><li>0.08</li><li>0.12</li><li>0.16</li><li>0.20</li><li>0.25</li></stageBonuses>
        <influenceResonanceEnabled>true</influenceResonanceEnabled>
      </li>
    </modExtensions>
    <recipeMaker>
      <researchPrerequisite>Cultist_StudiesOfLight</researchPrerequisite>
    </recipeMaker>
    <costStuffCount>45</costStuffCount>
    <stuffCategories><li>Fabric</li><li>Leathery</li></stuffCategories>
    <thingCategories><li>ApparelMisc</li></thingCategories>
    <statBases>
      <MaxHitPoints>110</MaxHitPoints>
      <WorkToMake>1900</WorkToMake>
      <Mass>0.45</Mass>
      <StuffEffectMultiplierArmor>0.24</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.12</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups><li>Torso</li><li>Shoulders</li></bodyPartGroups>
      <wornGraphicPath>Cultist/Apparel/FieldCoat/FieldCoat</wornGraphicPath>
      <layers><li>OnSkin</li></layers>
    </apparel>
  </ThingDef>
  <ThingDef ParentName="BaseGunWithQuality">
    <defName>Cultist_Engraver</defName>
    <label>light engraver</label>
    <description>A metal engraving stylus that focuses Lantern light into a mid-range golden beam. Its hardened point also serves in close quarters.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Cultist/Equipment/LightEngraver</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>25</costStuffCount>
    <stuffCategories><li>Metallic</li></stuffCategories>
    <statBases>
      <WorkToMake>1500</WorkToMake>
      <Mass>0.4</Mass>
      <AccuracyTouch>0.78</AccuracyTouch>
      <AccuracyShort>0.88</AccuracyShort>
      <AccuracyMedium>0.84</AccuracyMedium>
      <AccuracyLong>0.70</AccuracyLong>
      <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
    </statBases>
    <comps><li Class="Cultist.AffinityGearInspectProperties"/></comps>
    <modExtensions>
      <li Class="Cultist.AffinityGear">
        <affinity>Lantern</affinity>
        <stat>ResearchSpeed</stat>
        <rankBonuses><li>0.10</li><li>0.15</li><li>0.20</li></rankBonuses>
        <stageBonuses><li>0.05</li><li>0.08</li><li>0.12</li><li>0.16</li><li>0.20</li><li>0.25</li></stageBonuses>
        <meleeDamageStages><li>1.00</li><li>1.15</li><li>1.35</li><li>1.60</li><li>1.90</li><li>2.25</li></meleeDamageStages>
        <influenceResonanceEnabled>true</influenceResonanceEnabled>
      </li>
    </modExtensions>
    <recipeMaker>
      <researchPrerequisite>Cultist_StudiesOfLight</researchPrerequisite>
      <recipeUsers><li>CraftingSpot</li></recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Cultist_Proj_LanternBeam</defaultProjectile>
        <warmupTime>1.1</warmupTime>
        <range>20.9</range>
        <soundCast>ChargeLance_Fire</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>point</label>
        <capacities><li>Stab</li></capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>
</Defs>
