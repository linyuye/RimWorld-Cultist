<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TraderKindDef[defName="Caravan_Outlander_Exotic" or defName="Orbital_Exotic"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cultist_SurveyTranscript</thingDef>
        <countRange>0~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cultist_NightJournal</thingDef>
        <countRange>0~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cultist_ScholarDispatch</thingDef>
        <countRange>0~1</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cultist_AncientCodex</thingDef>
        <countRange>0~1</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>CultistBook</tradeTag>
        <thingDefCountRange>2~5</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
    </value>
  </Operation>
</Patch>
