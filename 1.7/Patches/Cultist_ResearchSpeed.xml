<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="ResearchSpeed"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="ResearchSpeed"]/parts</xpath>
      <value><li Class="Cultist.StatPart_SocietyResearch"/></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/StatDef[defName="ResearchSpeed"]</xpath>
      <value><parts><li Class="Cultist.StatPart_SocietyResearch"/></parts></value>
    </nomatch>
  </Operation>
